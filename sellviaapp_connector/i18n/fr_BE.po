msgid "<strong>Access locked.</strong> SellViaApp authentication is missing or expired. Disconnect this configuration, then connect and authorise it again before using catalogue, customer or order features."
msgstr "<strong>Accès verrouillé.</strong> L’authentification SellViaApp est absente ou expirée. Déconnectez cette configuration, puis reconnectez-la et autorisez-la avant d’utiliser le catalogue, les clients ou les commandes."

#. module: sellviaapp_connector
msgid "Unique connection"
msgstr "Connexion unique"

#. module: sellviaapp_connector
msgid "Manage the complete exchange between this Odoo database and SellViaApp from one clear workspace."
msgstr "Gérez tous les échanges entre cette base Odoo et SellViaApp depuis un espace unique et clair."

#. module: sellviaapp_connector
msgid "Connection required"
msgstr "Connexion requise"

#. module: sellviaapp_connector
msgid "Connect Odoo to SellViaApp"
msgstr "Connecter Odoo à SellViaApp"

#. module: sellviaapp_connector
msgid "Authorise this installation once. Until the connection is established, catalogue, customer and mobile-order synchronisation stays securely locked."
msgstr "Autorisez cette installation une seule fois. Tant que la connexion n’est pas établie, la synchronisation du catalogue, des clients et des commandes mobiles reste verrouillée."

#. module: sellviaapp_connector
msgid "Your SellViaApp password is never stored in Odoo."
msgstr "Votre mot de passe SellViaApp n’est jamais enregistré dans Odoo."

#. module: sellviaapp_connector
msgid "Approval in progress"
msgstr "Autorisation en cours"

#. module: sellviaapp_connector
msgid "Approve this Odoo installation"
msgstr "Autoriser cette installation Odoo"

#. module: sellviaapp_connector
msgid "Check this code in the SellViaApp dashboard, approve the request, then complete the connection here."
msgstr "Vérifiez ce code dans la Dashboard SellViaApp, autorisez la demande, puis terminez la connexion ici."

#. module: sellviaapp_connector
msgid "Access locked"
msgstr "Accès verrouillé"

#. module: sellviaapp_connector
msgid "Connection active"
