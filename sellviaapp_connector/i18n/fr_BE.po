msgid "Only Sales managers can synchronise contacts with SellViaApp."
msgstr "Seuls les responsables des ventes peuvent synchroniser les contacts avec SellViaApp."

#. module: sellviaapp_connector
msgid "Select at least one contact to update in SellViaApp."
msgstr "Sélectionnez au moins un contact à mettre à jour dans SellViaApp."

#. module: sellviaapp_connector
msgid "The selected records do not contain an eligible contact."
msgstr "Les enregistrements sélectionnés ne contiennent aucun contact admissible."

#. module: sellviaapp_connector
msgid "Only Sales managers can retrieve contacts from SellViaApp."
msgstr "Seuls les responsables des ventes peuvent récupérer les contacts depuis SellViaApp."

#. module: sellviaapp_connector
msgid "SellViaApp did not return a result for this contact."
msgstr "SellViaApp n’a renvoyé aucun résultat pour ce contact."

#. module: sellviaapp_connector
msgid "%s contact(s) synchronised; %s unchanged contact(s) skipped. %s invitation(s) sent, %s queued."
msgstr "%s contact(s) synchronisé(s) ; %s contact(s) inchangé(s) ignoré(s). %s invitation(s) envoyée(s), %s en attente."

#. module: sellviaapp_connector
msgid "Update stock"
msgstr "Mettre à jour le stock"

#. module: sellviaapp_connector
msgid "Update selected stock"
msgstr "Mettre à jour le stock sélectionné"

#. module: sellviaapp_connector
msgid "Update selected products"
msgstr "Mettre à jour les produits sélectionnés"

#. module: sellviaapp_connector
msgid "Last stock update"
msgstr "Dernière mise à jour du stock"

#. module: sellviaapp_connector
msgid "Stock every 5 minutes; catalogue every 15 minutes"
msgstr "Stock toutes les 5 minutes ; catalogue toutes les 15 minutes"

#. module: sellviaapp_connector
msgid "Publish the full catalogue when needed, and refresh changed stock quickly through a dedicated lightweight exchange."
msgstr "Publiez le catalogue complet lorsque nécessaire et actualisez rapidement les stocks modifiés grâce à un échange léger dédié."

#. module: sellviaapp_connector
msgid "A SellViaApp product or stock synchronisation is already in progress. Please wait for it to finish."
msgstr "Une synchronisation des produits ou du stock SellViaApp est déjà en cours. Attendez qu’elle soit terminée."

#. module: sellviaapp_connector
msgid "Select at least one product whose stock must be updated."
msgstr "Sélectionnez au moins un produit dont le stock doit être mis à jour."

#. module: sellviaapp_connector
msgid "SellViaApp did not return a result for this stock update."
msgstr "SellViaApp n’a renvoyé aucun résultat pour cette mise à jour de stock."

#. module: sellviaapp_connector
msgid "SellViaApp stock update"
msgstr "Mise à jour du stock SellViaApp"

#. module: sellviaapp_connector
msgid "SellViaApp stock is up to date"
msgstr "Le stock SellViaApp est à jour"

#. module: sellviaapp_connector
msgid "%s selected stock level(s) updated."
msgstr "%s niveau(x) de stock sélectionné(s) mis à jour."

#. module: sellviaapp_connector
msgid "%s stock level(s) updated; %s unchanged."
msgstr "%s niveau(x) de stock mis à jour ; %s inchangé(s)."

#. module: sellviaapp_connector
msgid " %s product(s) were first published to SellViaApp."
msgstr " %s produit(s) ont d’abord été publiés dans SellViaApp."

#. module: sellviaapp_connector
msgid " %s product(s) could not be updated because they are not published."
msgstr " %s produit(s) n’ont pas pu être mis à jour car ils ne sont pas publiés."

#. module: sellviaapp_connector
msgid " %s unpublished product(s) will be handled by the catalogue synchronisation."
msgstr " %s produit(s) non publié(s) seront traités par la synchronisation du catalogue."

#. module: sellviaapp_connector
msgid "Use this code to approve Odoo in the SellViaApp dashboard. Then return here and complete the connection."
msgstr "Utilisez ce code pour autoriser Odoo dans la Dashboard SellViaApp. Revenez ensuite ici pour terminer la connexion."

#. module: sellviaapp_connector
msgid "Approve the connection in SellViaApp"
msgstr "Autorisez la connexion dans SellViaApp"

#. module: sellviaapp_connector
msgid "Open the approval page, check the code and authorise this Odoo installation."
msgstr "Ouvrez la page d’autorisation, vérifiez le code et autorisez cette installation Odoo."

#. module: sellviaapp_connector
msgid "Already approved? Finish the connection now"
msgstr "Autorisation effectuée ? Terminez maintenant la connexion"

#. module: sellviaapp_connector
msgid "SellViaApp no."
msgstr "N° SellViaApp"

#. module: sellviaapp_connector
msgid "SellViaApp delivery"
msgstr "Livraison SellViaApp"

#. module: sellviaapp_connector
msgid "SellViaApp payment"
msgstr "Paiement SellViaApp"

#. module: sellviaapp_connector
msgid "SellViaApp login"
msgstr "Identifiant SellViaApp"

#. module: sellviaapp_connector
msgid "Send to"
msgstr "Envoyer vers"

#. module: sellviaapp_connector
msgid "Click the button below to unlock catalogue, stock, customer and order synchronisation."
msgstr "Cliquez sur le bouton ci-dessous pour activer la synchronisation du catalogue, du stock, des clients et des commandes."

