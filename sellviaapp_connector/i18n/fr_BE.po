msgid "Only one SellViaApp connection is allowed in this Odoo database."
msgstr "Une seule connexion SellViaApp est autorisée dans cette base Odoo."

#. module: sellviaapp_connector
msgid "Synchronise SellViaApp"
msgstr "Synchroniser avec SellViaApp"

#. module: sellviaapp_connector
msgid "Update selection"
msgstr "Mettre à jour la sélection"

#. module: sellviaapp_connector
msgid "Send only new or changed products to SellViaApp"
msgstr "Envoyer uniquement les produits nouveaux ou modifiés vers SellViaApp"

#. module: sellviaapp_connector
msgid "Update only the selected products in SellViaApp"
msgstr "Mettre à jour uniquement les produits sélectionnés dans SellViaApp"

#. module: sellviaapp_connector
msgid "Only Sales managers can synchronise products with SellViaApp."
msgstr "Seuls les responsables des ventes peuvent synchroniser les produits avec SellViaApp."

#. module: sellviaapp_connector
msgid "Synchronise contacts"
msgstr "Synchroniser les contacts"

#. module: sellviaapp_connector
msgid "A SellViaApp contact synchronisation is already in progress. Please wait for it to finish."
msgstr "Une synchronisation des contacts SellViaApp est déjà en cours. Attendez qu’elle soit terminée."

#. module: sellviaapp_connector
msgid "Send only new or changed contacts to SellViaApp"
msgstr "Envoyer uniquement les contacts nouveaux ou modifiés vers SellViaApp"

