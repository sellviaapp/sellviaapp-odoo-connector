<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="asset_partner_list_controller" model="ir.asset">
        <field name="name">SellViaApp contact list controller</field>
        <field name="bundle">web.assets_backend</field>
        <field name="directive">append</field>
        <field name="path">sellviaapp_connector/static/src/js/partner_list_controller.js</field>
        <field name="sequence">91</field>
    </record>

    <record id="asset_partner_list_buttons" model="ir.asset">
        <field name="name">SellViaApp contact list buttons</field>
        <field name="bundle">web.assets_backend</field>
        <field name="directive">append</field>
        <field name="path">sellviaapp_connector/static/src/xml/partner_list_buttons.xml</field>
        <field name="sequence">91</field>
    </record>

    <!-- Lists are substantially easier to control when thousands of contacts
         are involved and expose both the global and selected-contact actions. -->
    <record id="base.action_partner_form" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="account.res_partner_action_customer" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="view_partner_tree_sellviaapp" model="ir.ui.view">
        <field name="name">res.partner.tree.sellviaapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="js_class">sellviaapp_partner_list</attribute>
            </xpath>
            <xpath expr="//tree/field[1]" position="before">
                <header>
                    <button name="action_sellviaapp_fetch_customers"
                            type="object"
                            string="Retrieve SellViaApp customers"
                            class="btn-secondary"
                            display="always"
                            groups="sales_team.group_sale_manager"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <field name="sellviaapp_mobile_login" string="SellViaApp login" optional="hide"/>
                <field name="sellviaapp_mobile_sync_state" string="SellViaApp" widget="badge" optional="show"/>
                <field name="sellviaapp_mobile_synced_at" string="Last SellViaApp update" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_sellviaapp" model="ir.ui.view">
        <field name="name">res.partner.form.sellviaapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sellviaapp_sync_selected_customers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-mobile"
                        groups="sales_team.group_sale_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Send to</span>
                        <span class="o_stat_text">SellViaApp</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="SellViaApp" invisible="not sellviaapp_mobile_login and not sellviaapp_mobile_sync_error">
                    <group>
                        <group>
                            <field name="sellviaapp_mobile_customer_id"/>
                            <field name="sellviaapp_mobile_login"/>
                            <field name="sellviaapp_mobile_sync_state" widget="badge"/>
                        </group>
                        <group>
                            <field name="sellviaapp_mobile_invitation_status"/>
                            <field name="sellviaapp_mobile_synced_at"/>
                            <field name="sellviaapp_mobile_sync_error" invisible="not sellviaapp_mobile_sync_error"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
